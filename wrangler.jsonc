{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "byulmaru-media",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-16",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "routes": [
    {
      "pattern": "media-api.byulmaru.co",
      "custom_domain": true
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://kos.moe,https://dev.kos.moe,http://localhost:5173,http://localhost:5174",
    "PUBLIC_BASE_URL": "https://media.byulma.run"
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "byulmaru-media"
    }
  ]
}
