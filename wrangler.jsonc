{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "byulmaru-media",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-16",
  "compatibility_flags": ["nodejs_compat"],
  "limits": {
    "cpu_ms": 30000
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://kos.moe,https://dev.kos.moe,http://localhost:5173,http://localhost:5174",
    "PUBLIC_BASE_URL": "https://media.kos.moe"
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "byulmaru-media"
    }
  ]
}
