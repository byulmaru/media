{
  "name": "@byulmaru/media",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "dry-run": "wrangler deploy --dry-run --env=\"\" --outdir .wrangler/dry-run",
    "build:server": "esbuild src/server.ts --bundle --platform=node --format=esm --target=node24 --packages=external --outdir=dist",
    "build:temporal": "node scripts/build-temporal.mjs",
    "build:temporal:test": "esbuild scripts/temporal-test-runtime.ts --bundle --platform=node --format=esm --target=node24 --packages=external --outfile=dist/temporal/test-runtime.js",
    "start:server": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:server": "pnpm build:server && node --test scripts/test-server.mjs",
    "test:temporal": "pnpm build:server && pnpm build:temporal && pnpm build:temporal:test && node --test scripts/test-temporal.mjs",
    "test:watch": "vitest",
    "config:validate": "node scripts/validate-config.mjs",
    "deployment:validate": "node scripts/validate-config.mjs production",
    "infra:fmt": "terraform -chdir=terraform fmt -check",
    "infra:validate": "terraform -chdir=terraform validate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@hono/node-server": "^2.1.5",
    "@hono/zod-validator": "^0.9.0",
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/png": "^3.1.0",
    "@jsquash/webp": "^1.5.0",
    "@temporalio/activity": "1.23.0",
    "@temporalio/client": "1.23.0",
    "@temporalio/nexus": "1.23.0",
    "@temporalio/worker": "1.23.0",
    "@temporalio/workflow": "1.23.0",
    "hono": "^4.10.8",
    "nexus-rpc": "0.0.3",
    "sharp": "0.34.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.5",
    "@cloudflare/workers-types": "^5.20260716.1",
    "@temporalio/testing": "1.23.0",
    "@types/node": "^24.0.0",
    "esbuild": "0.28.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10",
    "wrangler": "^4.55.0"
  },
  "packageManager": "pnpm@11.10.0"
}
